{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "github",
  "description": "GitHub integration for managing repositories, issues, and pull requests",
  "config": {
    "mcpServers": {
      "github": {
        "command": "/path/to/reviewed/server-github",
        "args": [],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
        }
      }
    }
  },
  "setup": {
    "steps": [
      "1. Review and install an approved GitHub MCP server",
      "2. Replace /path/to/reviewed/server-github with its local executable",
      "3. Create a least-privilege GitHub token and set GITHUB_TOKEN",
      "4. Add the config to your Claude settings file"
    ],
    "requiredEnv": ["GITHUB_TOKEN"]
  },
  "tools": [
    "create_issue",
    "list_issues",
    "get_issue",
    "update_issue",
    "create_pull_request",
    "list_pull_requests",
    "get_pull_request",
    "merge_pull_request",
    "list_repositories",
    "create_repository",
    "search_code",
    "search_issues"
  ]
}
