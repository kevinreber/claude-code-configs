{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat ../.env*)",
      "Bash(cat */.env*)",
      "Bash(cat **/.env*)",
      "Bash(head .env*)",
      "Bash(head ./.env*)",
      "Bash(head */.env*)",
      "Bash(head **/.env*)",
      "Bash(tail .env*)",
      "Bash(tail ./.env*)",
      "Bash(tail */.env*)",
      "Bash(tail **/.env*)",
      "Bash(less .env*)",
      "Bash(less ./.env*)",
      "Bash(less */.env*)",
      "Bash(less **/.env*)",
      "Bash(more .env*)",
      "Bash(more ./.env*)",
      "Bash(more */.env*)",
      "Bash(more **/.env*)",
      "Bash(grep * .env*)",
      "Bash(grep * ./.env*)",
      "Bash(grep * */.env*)",
      "Bash(grep * **/.env*)",
      "Bash(awk * .env*)",
      "Bash(awk * **/.env*)",
      "Bash(sed * .env*)",
      "Bash(sed * **/.env*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ M=$(jq -r '.model // empty' 2>/dev/null); case \"$M\" in *fable*) ;; *) cat \"$HOME/.claude/hooks/fable-digest.md\";; esac; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo $TOOL_INPUT | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get(\"file_path\",\"\"))' 2>/dev/null); [[ \"$FILE\" == *.md ]] && echo \"\ud83d\udcdd Edited: $FILE\" || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/pr-sync-check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/confirm-destructive.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude has finished\" with title \"Claude Code\" sound name \"Purr\"' 2>/dev/null || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude is waiting for permission\" with title \"Claude Code\" sound name \"Funk\"' 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/statusline-command.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
